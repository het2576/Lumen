# Supabase Dashboard -> Project Settings -> Data API -> Project URL
SUPABASE_URL=

# Supabase Dashboard -> Project Settings -> Data API -> Project API keys -> service_role
# Backend only, never expose this client-side. Used both for data access and to validate
# the session tokens the frontend sends (works for Google sign-in and magic link alike).
SUPABASE_KEY=

# Google AI Studio
GEMINI_API_KEY=

# Comma-separated list of frontend origins allowed to call this API.
# Local dev default is http://localhost:3000 if unset. Add your deployed frontend URL too, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=

# --- Optional ---------------------------------------------------------------------------

# Exact Gemini model for answers. Pinned on purpose: change it only after the evals pass.
# GENERATION_MODEL=gemini-3.5-flash-lite

# Tracing with Langfuse (https://cloud.langfuse.com -> Project -> Settings -> API keys).
# Without these, per-request timing/token lines are still written to the logs.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com
# USD per 1M tokens, for cost estimates in logs/traces. Check current Gemini pricing first.
# PRICE_INPUT_PER_M=
# PRICE_OUTPUT_PER_M=

# Ingestion queue. The worker runs inside the API process by default; to run it as a
# separate service set INGESTION_WORKER_ENABLED=false here and start `python -m app.worker`.
# INGESTION_WORKER_ENABLED=true
# INGESTION_WORKER_THREADS=1
